{
  "name": "ai-investment-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && node scripts/verify-client-bundle.mjs",
    "deploy:dry-run": "node node_modules/wrangler/bin/wrangler.js deploy --dry-run --config dist/ai_investment_admin/wrangler.json --outdir work/deploy-dry-run",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:browser": "playwright test",
    "smoke:live": "node scripts/live-smoke.mjs --allow-network",
    "smoke:infrastructure": "node scripts/infrastructure-smoke.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.0",
    "@cloudflare/workers-types": "5.20260929.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.143.0"
  }
}
