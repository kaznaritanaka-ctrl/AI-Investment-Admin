{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-investment-admin",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ],
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": false
  }
}
